# Copy to .env at the repository root. Never commit .env.
# KEY=VALUE per line, UTF-8, each value as written: no quotes, no escapes, spaces kept.
# The local database needs nothing here: application.yml defaults to compose.yaml's.
# A deployment sets GLOSS_DB_URL, GLOSS_DB_USER and GLOSS_DB_PASSWORD.

# Created once at startup when no operator exists. Must be changed at first sign-in.
GLOSS_FIRST_OPERATOR_LOGIN_ID=
GLOSS_FIRST_OPERATOR_PASSWORD=
GLOSS_FIRST_OPERATOR_NAME=

# Encrypts readers' API keys; the server refuses to start without one. version:base64 of 32
# random bytes, comma-separated, the newest sealing. This file is read as written, so write the
# value itself, e.g.: echo "GLOSS_API_KEY_MASTER_KEYS=1:$(openssl rand -base64 32)" >> .env
# Keep it apart from every other secret: losing it makes every stored key unreadable.
GLOSS_API_KEY_MASTER_KEYS=

# YES24 Open API key (developers.yes24.com), for finding a book and its contents by title.
# Optional: without it, readers type a book's contents in.
GLOSS_YES24_API_KEY=
