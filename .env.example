# Copy to .env at the repository root. Never commit .env.
# KEY=VALUE per line, UTF-8, each value as written: no quotes, no escapes, spaces kept.
# The local database needs nothing here: application.yml defaults to compose.yaml's.
# A deployment sets GLOSS_DB_URL, GLOSS_DB_USER and GLOSS_DB_PASSWORD.

# Created once at startup when no operator exists. Must be changed at first sign-in.
GLOSS_FIRST_OPERATOR_LOGIN_ID=
GLOSS_FIRST_OPERATOR_PASSWORD=
GLOSS_FIRST_OPERATOR_NAME=
